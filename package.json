{
	"name": "n8n-nodes-open-project-api",
	"version": "0.1.11",
	"description": "n8n community nodes for the OpenProject, Kaneo and Woodpecker CI APIs",
	"license": "MIT",
	"homepage": "https://github.com/biela-kamil/n8n-open-project",
	"keywords": [
		"n8n-community-node-package",
		"open-project",
		"kaneo"
	],
	"author": {
		"name": "Kamil Biela",
		"email": "biela.kamil@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/biela-kamil/n8n-open-project"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "fnm exec n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/OpenProjectApi.credentials.js",
			"dist/credentials/WoodpeckerCredentialsApi.credentials.js",
			"dist/credentials/KaneoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OpenProject/OpenProject.node.js",
			"dist/nodes/Woodpecker/Woodpecker.node.js",
			"dist/nodes/Kaneo/Kaneo.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.3",
		"eslint": "^10.13.0",
		"prettier": "^3.9.10",
		"release-it": "^21.1.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
